#!/bin/sh
# Gate-level simulation of the routed step 1 netlist.
#
# Run from step1/, after place-and-route has written fullchip.pnr.v and
# fullchip_WC.sdf into this directory. COURSE_PDK must point at the PDK root.
# The cell models are referenced where they live, so no foundry file is ever
# copied into this tree.
#
#   ./run_gui                  batch: everything goes to stdout, so
#                              ./run_gui 2>&1 | tee gls.log captures the SDF
#                              statistics and the PASS/FAIL line
#   GUI=+gui ./run_gui         opens SimVision instead. Note that run-time
#                              output then goes to the SimVision console, not
#                              to stdout - a piped log will hold only the
#                              elaboration messages.
#
# The clock runs at 2.0 ns here, not at the 1.0 ns target. Post-route reg2reg
# WNS is -0.170 ns, so the netlist does not close at 1 GHz, and the testbench
# gives its inputs only half a period of setup where the SDC assumed 0.8 ns.
# Tighten it from the command line to find where the netlist stops working:
#   +define+CLK_HALF=0.7        -> 1.4 ns period
#
# SEQ_UDP gives sequential UDPs a floor delay. SDF annotation is never quite
# complete - the course flow reports around 90% - and whatever it misses is
# left at zero delay, where a cell can race its own clock and settle to X.
# Set it if the output comes back X:
#   SEQ_UDP=+xmseq_udp_delay+20ps ./run_gui
#
# NO_SDF skips the back-annotation entirely, which splits the problem space in
# one run: a correct readout without the SDF and X with it means the fault is
# in the timing; X either way means it is initialisation, or the netlist. Pair
# it with SEQ_UDP, since an un-annotated netlist has no delays at all:
#   NO_SDF=1 SEQ_UDP=+xmseq_udp_delay+20ps ./run_gui 2>&1 | tee gls_nosdf.log

GUI=${GUI:-}
SEQ_UDP=${SEQ_UDP:-}
if [ -n "${NO_SDF:-}" ]; then NO_SDF_DEF=+define+NO_SDF; else NO_SDF_DEF=; fi

xrun \
$GUI \
$SEQ_UDP \
+access+rwc \
+xm64bit \
+xmstatus \
+xmtimescale+1ns/1ps \
+xmoveride_timescale \
+define+GLS \
$NO_SDF_DEF \
-v ./fullchip.pnr.v \
-v $COURSE_PDK/verilog/tcbn65gplus.v \
./verilog/fullchip_tb.v
