#!/bin/sh
# Gate-level simulation of the routed step 3 netlist.
#
# Run from step3/, after place-and-route has written fullchip.pnr.v and
# fullchip_WC.sdf into this directory. COURSE_PDK must point at the PDK root.
# The cell models are referenced where they live, so no foundry file is ever
# copied into this tree.
#
# Step 3 is the hierarchical build: the three memories are hard macros, so the
# top netlist only instantiates them and their models have to be supplied
# here. The two Stage A netlists below cover all three instances -
# sram_w16_sram_bit64 serves qmem and kmem, sram_w16_sram_bit160 serves the
# psum memory. sram_macro_stub.v is a synthesis-only file and must NEVER be
# listed here: it declares the ports and nothing else, so every read would
# return X and the hunt would start in the wrong place.
#
# The stub also arrives by a second route, inside the netlist itself, and this
# script removes it on every run - see the note above SRC below. The cleaned
# copy goes under gls/, which .gitignore keeps out of the repo: it is a mapped
# netlist, and a mapped netlist must never be committed.
#
#   ./run_gui                  batch: everything goes to stdout, so
#                              ./run_gui 2>&1 | tee gls.log captures the SDF
#                              statistics and the PASS/FAIL line
#   GUI=+gui ./run_gui         opens SimVision instead. Note that run-time
#                              output then goes to the SimVision console, not
#                              to stdout - a piped log will hold only the
#                              elaboration messages.
#
# The clock runs at 5.0 ns here, not at the 1.0 ns target. Post-route setup
# WNS is -2.151 ns at 1.0 ns (timingReports/postRoute.summary, second PnR run),
# so static timing puts the minimum period at 1.0 + 2.151 = 3.151 ns, useful
# skew included; the testbench also gives its inputs only half a period of
# setup. Tighten it from the command line to find where the SDF-annotated
# netlist stops working - failing near 3.15 ns would be an independent check on
# the static timing number:
#   CLK_HALF=1.6 ./run_gui      -> 3.2 ns period
#
# SEQ_UDP gives sequential UDPs a floor delay. It is ON by default for NO_SDF
# runs only: a netlist simulated without SDF has no delays at all, so data and
# clock reach a flop at the same instant and race.
#
# It is OFF by default whenever the SDF is in use, because the two do not mix.
# With it on, xmelab printed *W,SDFSKPA - "Ignore $sdf_annotate ... because of
# -nospecify option" - although nothing on this command line asks for
# -nospecify, and the run that looked like an SDF pass was in fact zero-delay.
# Step 1's own SDF run (step1/README.md) did not use it either. So when a run
# is meant to carry the SDF, check the log for the SDF statistics and for the
# absence of SDFSKPA; a PASS alone proves nothing about annotation.
#   NO_SDF=1 SEQ_UDP=0 ./run_gui               off for a zero-delay run
#   NO_SDF=1 SEQ_UDP=+xmseq_udp_delay+50ps ./run_gui    a different floor
# To turn it off by default, comment out the SEQ_UDP_DEFAULT line below.
#
# NETLIST picks which netlist to simulate. Post-synthesis simulation is the
# standard gate between synthesis and place-and-route, and this flow skipped
# it, so a failure downstream cannot be pinned on either tool. Run the
# synthesis netlist with no SDF - there is none for it:
#   NETLIST=./netlist/fullchip.out.v NO_SDF=1 ./run_gui
# Failing there too means the netlist left synthesis already broken. Passing
# there means place-and-route is where it broke.
#
# NO_SDF skips the back-annotation entirely, which splits the problem space in
# one run: a correct readout without the SDF and X with it means the fault is
# in the timing. X either way narrows it far less than it looks - the two runs
# still share the testbench, the library and this invocation - so read it as
# "not timing" and nothing more:
#   NO_SDF=1 ./run_gui 2>&1 | tee gls_nosdf.log
#
# RTL=1 runs the RTL through this same invocation instead of a netlist, from
# the course filelist and with no GLS define. The RTL was signed off under a
# different simulator, so simulator and netlist changed together and neither
# has been held still. This holds everything but the design description:
#   RTL=1 ./run_gui 2>&1 | tee rtl_xrun.log
# Failing here as well puts the fault in the testbench, this script or the
# simulator, and clears synthesis and place-and-route entirely.

GUI=${GUI:-}
if [ -n "${NO_SDF:-}" ]; then NO_SDF_DEF=+define+NO_SDF; else NO_SDF_DEF=; fi

# Comment out this one line to run without the sequential UDP floor by default.
# The default applies to NO_SDF runs only - see the note above on SDFSKPA.
SEQ_UDP_DEFAULT=+xmseq_udp_delay+20ps
case "${SEQ_UDP-}" in
    0)  SEQ_UDP= ;;                            # off for this run
    +*) ;;                                     # an explicit option, as given
    *)  if [ -n "${NO_SDF:-}" ]; then          # zero-delay run: floor on
            SEQ_UDP=${SEQ_UDP_DEFAULT-}
        else                                   # SDF run: floor off
            SEQ_UDP=
        fi ;;
esac

# INIT0=1 zero-initializes variables and memories. Measured ineffective on the
# step 1 netlist and not re-measured here: the flop state lives in UDP
# primitives, which
# -initreg0/-initmem0 do not touch, so the X power-up state survives and the
# X-locked reset cones (see below) never clear. Kept because it documents the
# attempt and still applies to variable-based models.
#
# The underlying disease: DC factored the synchronous reset of five mac_col
# variants (and parts of fifo_depth16) through shared product terms. That is
# two-state equivalent to the RTL - silicon resets fine - but under a
# four-state simulator an X power-up value gates the reset off and the
# register locks at X forever. Registers that were mapped to sync-clear-pin
# flops (DFKCNQ*, e.g. inst_q) exit X cleanly everywhere; the fix is to make
# DC map the rest the same way via the sync_set_reset directive.
if [ -n "${INIT0:-}" ]; then INIT_OPT="-initreg0 -initmem0"; else INIT_OPT=; fi

# CLK_HALF=<ns> overrides the clock half period, whose GLS default lives in
# the testbench. Two things set the floor here. Static timing needs 3.151 ns,
# and the clock insertion delay spans 0.303 to 1.951 ns
# (fullchip.post_route.skew.rpt): a flop whose clock arrives later than the
# testbench changes its inputs captures the next cycle's value one cycle
# early, which in step 1 showed up as fifo columns reading one row behind.
# Slowing the simulation clock past both is the standard remedy and claims
# nothing about design speed; the frequency claim rests on STA.
#   CLK_HALF=2.0 ./run_gui
if [ -n "${CLK_HALF:-}" ]; then CLK_DEF=+define+CLK_HALF=$CLK_HALF; else CLK_DEF=; fi

if [ -n "${RTL:-}" ]; then
    GLS_DEF=
    SRC="-f ./filelist"
else
    GLS_DEF=+define+GLS

    # Both netlists this flow writes carry two empty modules named after the
    # macros. Synthesis writes the port-only stub because write -hier writes
    # every design it holds, and Innovus writes it back out because saveNetlist
    # includes leaf cell definitions by default (innovusTCR, saveNetlist).
    # Left in, they shadow the Stage A models below - xrun reports LIBNOU,
    # "given but not used", for those - and the memories read back as Z.
    # Strip them into a copy on every run so no netlist can slip through.
    NL=${NETLIST:-./fullchip.pnr.v}
    [ -r "$NL" ] || { echo "run_gui: cannot read netlist $NL" >&2; exit 1; }
    mkdir -p gls
    GLS_NL=gls/$(basename "$NL" .v).gls.v
    MACRO_DEF='^module sram_w16_sram_bit(64|160)[ (]'
    n=$(grep -cE "$MACRO_DEF" "$NL")
    awk -v re="$MACRO_DEF" '$0 ~ re {skip=1} !skip {print} /^endmodule/ {if (skip) skip=0}' "$NL" > "$GLS_NL"
    echo "run_gui: $NL -> $GLS_NL, $n macro module definition(s) removed"

    # -v marks a library file: xrun pulls a module out of it only when
    # something instantiates that module, so nothing here can become a top.
    # The testbench is the one plain source file, and it must be listed once -
    # listing it twice defines fullchip_tb twice and elaboration stops.
    SRC="-v $GLS_NL \
	 -v ./subckt/sram_w16_sram_bit64.pnr.v \
	 -v ./subckt/sram_w16_sram_bit160.pnr.v \
	 -v $COURSE_PDK/verilog/tcbn65gplus.v \
	 ./verilog/fullchip_tb.v"
fi

# The invocation is echoed because xrun does not put its own argv in the
# output: a log that lacks this line proves nothing about which flags ran,
# and one debugging round was lost to exactly that misreading.
ARGS="$GUI $SEQ_UDP $INIT_OPT $CLK_DEF +access+rwc +xm64bit +xmstatus +xmtimescale+1ns/1ps +xmoveride_timescale $GLS_DEF $NO_SDF_DEF $SRC"
echo "run_gui invoking: xrun $ARGS"
xrun $ARGS
